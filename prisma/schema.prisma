
generator client {
  provider = "prisma-client"
  output = "./generated"
  generatedFileExtension = "ts"
  moduleFormat           = "esm"
  runtime                = "bun"
}

datasource db {
  provider = "sqlite"
}

model Todo {
  id Int @id @default(autoincrement())
  title String
  description String?
  completed Boolean?
  user User @relation(fields: [userid], references: [id], onDelete: Cascade)
  userid Int
}

model User {
  id Int @id @default(autoincrement())
  name String @unique
  todos Todo[]
}