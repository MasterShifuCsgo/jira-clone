
generator client {
  provider = "prisma-client"
  output = "./generated"
  generatedFileExtension = "ts"
  moduleFormat           = "esm"
  runtime                = "bun"
}

datasource db {
  provider = "sqlite"
}

model Todo {
  id Int @id @default(autoincrement())
  title String
  description String?
  completed Boolean?
}
